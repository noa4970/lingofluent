{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_word_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailyReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Send daily word reminders",
            "description": "Pushes a word to everyone whose reminder time has arrived"
          }
        }
      }
    ]
  },
  "name": "Daily Word Reminder",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Checks every 15 minutes and pushes a daily word reminder to everyone whose chosen time has arrived."
}